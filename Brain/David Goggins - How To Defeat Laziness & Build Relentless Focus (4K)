var bar=document.getElementById("bar"),top=document.getElementById("top");
function sc(){var h=document.documentElement,m=h.scrollHeight-h.clientHeight;bar.style.width=(m>0?h.scrollTop/m*100:0)+"%";top.style.display=h.scrollTop>400?"block":"none"}
window.addEventListener("scroll",sc);sc();
top.onclick=function(){window.scrollTo({top:0,behavior:"smooth"})};
})();
</script>
</body>
